{{> navbar}}

<div class="container mt-5 mb-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-journal-text text-primary"></i> System Audit Trail</h2>
    
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover border">
                    <thead class="table-dark">
                        <tr>
                            <th>Date / Time</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Activity</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each logs}}
                        <tr>
                            <td>{{this.timestamp}}</td>
                            <td>{{this.username}}</td>
                            <td><span class="badge bg-secondary">{{this.role}}</span></td>
                            <td>{{this.activity}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>